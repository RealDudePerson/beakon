# ignore instance folder
instance/

# ignore generated config (contains SECRET_KEY and MAPBOX_API_KEY)
config.cfg
config.cfg.bak

# Beakon's own hosted Android companion app (12.8MB binary). This is a copy of
# the built APK from ~/projects/beakon-android and must be refreshed when that
# app is rebuilt — see readme.md. Kept out of git so the repository does not
# carry the binary. Note: a freshly cloned instance therefore does NOT have it.
static/*.apk

# ignore our virtual environment
venv/
.venv/

#---- PyCharm ----
.idea

#---------------- Generic Python Ignores --------------

 Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]

# C extensions
*.so

